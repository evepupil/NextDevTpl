{
  "schemaVersion": 1,
  "id": "contrast",
  "name": "Contrast",
  "version": "1.0.0",
  "compatibility": {
    "template": "^4.0.0",
    "viewApi": 1
  },
  "modules": [
    "admin",
    "analytics",
    "auth",
    "blog",
    "credits",
    "dashboard",
    "mail",
    "marketing",
    "operations",
    "payment",
    "pseo",
    "settings",
    "shared",
    "storage",
    "subscription",
    "support"
  ],
  "viewEntries": {
    "auth": "views/account/entry.ts",
    "blog": "views/journal/entry.ts",
    "dashboard": "views/workspace/dashboard-entry.ts",
    "marketing": "views/marketing/entry.ts",
    "pseo": "views/discovery/entry.ts",
    "settings": "views/preferences/entry.ts",
    "shared": "views/workspace/entry.ts",
    "support": "views/helpdesk/entry.ts"
  },
  "uiOverrides": {
    "button.tsx": "ui/button.tsx"
  },
  "customization": {
    "brandColor": {
      "variable": "--primary",
      "foregroundVariable": "--primary-foreground"
    },
    "radius": {
      "variable": "--radius",
      "min": 0,
      "max": 0,
      "unit": "rem"
    },
    "fonts": {
      "body": [
        {
          "id": "system",
          "label": "System sans"
        }
      ],
      "heading": [
        {
          "id": "system-mono",
          "label": "System mono"
        }
      ],
      "mono": [
        {
          "id": "system-mono",
          "label": "System mono"
        }
      ]
    },
    "defaultTheme": ["system"]
  },
  "supportsPalettes": false,
  "dependencies": {
    "lucide-react": "0.562.0"
  },
  "assets": [
    {
      "id": "lucide-react",
      "kind": "dependency",
      "author": "Lucide contributors",
      "source": "https://github.com/lucide-icons/lucide",
      "license": "ISC",
      "purpose": "visual",
      "package": {
        "name": "lucide-react",
        "version": "0.562.0"
      }
    },
    {
      "id": "contrast-brand",
      "kind": "file",
      "author": "NextDevTpl contributors",
      "source": "https://github.com/evepupil/NextDevTpl/blob/ac2b7da/src/app/icon.svg",
      "license": "MIT",
      "purpose": "visual",
      "files": ["assets/brand.svg"]
    },
    {
      "id": "google-sign-in-mark",
      "kind": "inline",
      "author": "Google",
      "source": "https://developers.google.com/identity/branding-guidelines",
      "license": "Google Identity branding guidelines",
      "purpose": "functional"
    }
  ],
