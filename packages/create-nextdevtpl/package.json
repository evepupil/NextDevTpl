{
  "name": "create-nextdevtpl",
  "version": "4.0.0",
  "description": "Create a clean NextDevTpl project from composable recipes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evepupil/NextDevTpl.git",
    "directory": "packages/create-nextdevtpl"
  },
  "homepage": "https://github.com/evepupil/NextDevTpl#readme",
  "bugs": {
    "url": "https://github.com/evepupil/NextDevTpl/issues"
  },
  "keywords": [
    "nextjs",
    "saas",
    "starter",
    "cloudflare-workers",
    "vercel"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-nextdevtpl": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "palettes",
    "template",
    "catalog.json",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "assemble-template": "node scripts/assemble-template.mjs",
    "prepare-demo-contract": "node scripts/prepare-demo-contract.mjs",
    "build": "pnpm run prepare-demo-contract && tsc -p tsconfig.json",
    "skin:check": "pnpm run build && node scripts/verify-skin.mjs check",
    "skin:hash": "pnpm run build && node scripts/verify-skin.mjs hash",
    "typecheck": "pnpm run prepare-demo-contract && tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run prepare-demo-contract && pnpm run assemble-template && pnpm run build"
  },
  "dependencies": {
    "colorjs.io": "0.7.1",
    "postcss": "8.5.6",
    "postcss-value-parser": "4.2.0",
    "semver": "7.7.3",
    "tar-stream": "3.2.2",
    "typescript": "5.9.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/semver": "7.8.0"
  }
}
