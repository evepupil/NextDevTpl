{
  "name": "create-nextdevtpl",
  "version": "2.6.0",
  "description": "Create a clean NextDevTpl project from composable recipes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evepupil/NextDevTpl.git",
    "directory": "packages/create-nextdevtpl"
  },
  "homepage": "https://github.com/evepupil/NextDevTpl#readme",
  "bugs": {
    "url": "https://github.com/evepupil/NextDevTpl/issues"
  },
  "keywords": [
    "nextjs",
    "saas",
    "starter",
    "cloudflare-workers",
    "vercel"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-nextdevtpl": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "catalog.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "assemble-template": "node scripts/assemble-template.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run assemble-template && pnpm run build"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
